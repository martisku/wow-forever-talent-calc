{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained talent ruleset revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "revision", "name", "classes", "intent", "hashes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"enum": ["baseline", "experiment"]},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "intent": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": {"id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}}},
    "changes": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}},
    "hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "baseline"}}}, "then": {"required": ["sourceCommit"], "not": {"anyOf": [{"required": ["baseline"]}, {"required": ["changes"]}]}}},
    {"if": {"properties": {"kind": {"const": "experiment"}}}, "then": {"required": ["baseline", "changes"], "not": {"required": ["sourceCommit"]}}}
  ]
}
